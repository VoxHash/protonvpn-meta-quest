+    /**
+     * Meta Quest headsets (Quest 2/3/3S/Pro) report manufacturer Oculus and
+     * oculus.hardware.standalone_vr. Treat them as TV so Routing/MainActivity
+     * hand off to TvMainActivity + TvQrLoginActivity.
+     *
+     * Quest Meta Quest patch — VoxHash Technologies / protonvpn-meta-quest.
+     */
+    private fun Context.isMetaQuestDevice(): Boolean {
+        val manufacturer = Build.MANUFACTURER.orEmpty()
+        val brand = Build.BRAND.orEmpty()
+        val model = Build.MODEL.orEmpty()
+        val device = Build.DEVICE.orEmpty().lowercase()
+        val questDevices = setOf(
+            "monterey", // original Quest
+            "hollywood", // Quest 2
+            "seacliff", // Quest Pro
+            "eureka",   // Quest 3
+            "panther",  // Quest 3S
+        )
+        return manufacturer.equals("Oculus", ignoreCase = true) ||
+            brand.equals("oculus", ignoreCase = true) ||
+            model.contains("Quest", ignoreCase = true) ||
+            device in questDevices ||
+            packageManager.hasSystemFeature("oculus.hardware.standalone_vr") ||
+            packageManager.hasSystemFeature("oculus.software.handtracking")
+    }
